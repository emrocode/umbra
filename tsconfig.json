{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2022",
    "module": "ES2022",
    "strict": true,
    "removeComments": false,
    "noEmitOnError": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "types": ["jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
